page {
  background: #090B12;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #f8fafc;
  font-size: 28rpx;
  min-height: 100vh;
}

.container {
  padding: 32rpx 28rpx;
  min-height: 100vh;
}

.card {
  background: #111522;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #1F2937;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.32);
}

.btn-primary {
  background: linear-gradient(135deg, #F43F7A 0%, #ec4899 100%);
  color: white;
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.32), 0 0 0 1rpx rgba(244, 63, 122, 0.2);
  transition: all 0.2s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 122, 0.22);
}

.btn-secondary {
  background: rgba(244, 63, 122, 0.1);
  color: #F43F7A;
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: rgba(244, 63, 122, 0.18);
}

.btn-small {
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.btn-outline {
  background: #111522;
  color: #94a3b8;
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #1F2937;
}

.btn-outline::after {
  border: none;
}

.btn-outline:active {
  border-color: #F43F7A;
  color: #F43F7A;
  background: rgba(244, 63, 122, 0.08);
}

.text-primary {
  color: #F43F7A;
}

.text-secondary {
  color: #94a3b8;
}

.text-muted {
  color: #64748b;
}

.text-success {
  color: #34d399;
}

.text-warning {
  color: #fbbf24;
}

.text-rose {
  color: #fb7185;
}

.text-ai {
  color: #8B5CF6;
}

.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

.gap-4 {
  gap: 32rpx;
}

.mt-1 {
  margin-top: 12rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.mt-3 {
  margin-top: 24rpx;
}

.mt-4 {
  margin-top: 32rpx;
}

.mb-2 {
  margin-bottom: 16rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mb-4 {
  margin-bottom: 32rpx;
}

.p-3 {
  padding: 24rpx;
}

.p-4 {
  padding: 32rpx;
}

.rounded-xl {
  border-radius: 20rpx;
}

.rounded-2xl {
  border-radius: 24rpx;
}

.rounded-3xl {
  border-radius: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 40rpx;
}

.font-bold {
  font-weight: 700;
}

.font-semibold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F43F7A 0%, #8B5CF6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(244, 63, 122, 0.25);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-success {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.2);
}

.badge-warning {
  background: rgba(251, 191, 36, 0.12);
  color: #fbbf24;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.badge-rose {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.2);
}

.badge-primary {
  background: rgba(244, 63, 122, 0.12);
  color: #F43F7A;
  border: 1rpx solid rgba(244, 63, 122, 0.2);
}

.badge-ai {
  background: rgba(139, 92, 246, 0.12);
  color: #8B5CF6;
  border: 1rpx solid rgba(139, 92, 246, 0.2);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #64748b;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 20rpx;
}

.divider {
  height: 2rpx;
  background: #1F2937;
  margin: 24rpx 0;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(9, 11, 18, 0.95);
  backdrop-filter: blur(20px);
  display: flex;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.32);
  z-index: 100;
  border-top: 2rpx solid #1F2937;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #64748b;
  transition: all 0.2s;
  padding: 8rpx 0;
}

.nav-item.active {
  color: #F43F7A;
}

.nav-item.active .nav-icon {
  transform: scale(1.1);
  text-shadow: 0 0 16rpx rgba(244, 63, 122, 0.5);
}

.nav-icon {
  font-size: 48rpx;
  transition: transform 0.2s;
}

.nav-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 全局输入框 */
.input {
  width: 100%;
  height: 88rpx;
  background: #111522;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #1F2937;
  color: #f8fafc;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  background: #111522;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #1F2937;
  color: #f8fafc;
  line-height: 1.6;
}

.input:focus,
.textarea:focus {
  border-color: #F43F7A;
  box-shadow: 0 0 0 4rpx rgba(244, 63, 122, 0.1);
}
