/* 设计令牌：颜色与语义规范 */
page {
  --primary: #F43F7A;
  --primary-light: #ec4899;
  --primary-soft: rgba(244, 63, 122, 0.12);
  --primary-glow: rgba(244, 63, 122, 0.25);

  --accent: #8B5CF6;
  --accent-soft: rgba(139, 92, 246, 0.12);

  --success: #34d399;
  --success-dark: #10b981;
  --success-soft: rgba(52, 211, 153, 0.12);
  --warning: #fbbf24;
  --warning-dark: #f97316;
  --warning-soft: rgba(251, 191, 36, 0.12);
  --accent-light: #a78bfa;
  --accent-lighter: #c4b5fd;
  --danger: #f87171;
  --danger-soft: rgba(239, 68, 68, 0.12);
  --info: #60a5fa;
  --info-soft: rgba(59, 130, 246, 0.12);

  --bg: #090B12;
  --surface: #111522;
  --surface-elevated: #0B0F1A;
  --border: #1F2937;
  --border-light: #374151;

  --text: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-placeholder: rgba(255, 255, 255, 0.35);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--text);
  font-size: 28rpx;
  min-height: 100vh;
}

.container {
  padding: 32rpx 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--border);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.32);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.32), 0 0 0 1rpx rgba(244, 63, 122, 0.2);
  transition: all 0.2s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 122, 0.22);
}

.btn-primary[disabled] {
  background: rgba(244, 63, 122, 0.35);
  color: rgba(255, 255, 255, 0.6);
  box-shadow: none;
}

.btn-secondary {
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: rgba(244, 63, 122, 0.18);
}

.btn-disabled {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-muted);
  border-radius: 16rpx;
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  line-height: 1.2;
}

.btn-small {
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.btn-outline {
  background: var(--surface);
  color: var(--text-secondary);
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid var(--border);
}

.btn-outline::after {
  border: none;
}

.btn-outline:active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(244, 63, 122, 0.08);
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-muted);
}

.text-success {
  color: var(--success);
}

.text-warning {
  color: var(--warning);
}

.text-rose {
  color: #fb7185;
}

.text-ai {
  color: var(--accent);
}

.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.justify-center {
  justify-content: center;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

.gap-4 {
  gap: 32rpx;
}

.mt-1 {
  margin-top: 12rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.mt-3 {
  margin-top: 24rpx;
}

.mt-4 {
  margin-top: 32rpx;
}

.mb-2 {
  margin-bottom: 16rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mb-4 {
  margin-bottom: 32rpx;
}

.p-3 {
  padding: 24rpx;
}

.p-4 {
  padding: 32rpx;
}

.rounded-xl {
  border-radius: 20rpx;
}

.rounded-2xl {
  border-radius: 24rpx;
}

.rounded-3xl {
  border-radius: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 40rpx;
}

.font-bold {
  font-weight: 700;
}

.font-semibold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-success {
  background: var(--success-soft);
  color: var(--success);
  border: 1rpx solid rgba(52, 211, 153, 0.2);
}

.badge-warning {
  background: var(--warning-soft);
  color: var(--warning);
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.badge-rose {
  background: rgba(251, 113, 133, 0.12);
  color: #fb7185;
  border: 1rpx solid rgba(251, 113, 133, 0.2);
}

.badge-primary {
  background: var(--primary-soft);
  color: var(--primary);
  border: 1rpx solid rgba(244, 63, 122, 0.2);
}

.badge-ai {
  background: var(--accent-soft);
  color: var(--accent);
  border: 1rpx solid rgba(139, 92, 246, 0.2);
}

.badge-muted {
  background: rgba(100, 116, 139, 0.12);
  color: var(--text-muted);
  border: 1rpx solid rgba(100, 116, 139, 0.2);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-muted);
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-soft) 0%, var(--accent-soft) 100%);
  border: 2rpx solid rgba(244, 63, 122, 0.18);
  color: var(--primary);
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(244, 63, 122, 0.15);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.divider {
  height: 2rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(9, 11, 18, 0.95);
  backdrop-filter: blur(20px);
  display: flex;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.32);
  z-index: 100;
  border-top: 2rpx solid var(--border);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: var(--text-muted);
  transition: all 0.2s;
  padding: 8rpx 0;
  position: relative;
}

.nav-item.active {
  color: var(--primary);
}

.nav-item.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary);
  box-shadow: 0 0 12rpx var(--primary-glow);
}

.nav-item.active .nav-icon {
  transform: scale(1.1);
  text-shadow: 0 0 16rpx rgba(244, 63, 122, 0.5);
}

.nav-icon {
  font-size: 44rpx;
  transition: transform 0.2s;
  font-weight: 500;
}

.nav-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 全局输入框 */
.input {
  width: 100%;
  height: 88rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  color: var(--text);
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  color: var(--text);
  line-height: 1.6;
}

.input:focus,
.textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(244, 63, 122, 0.1);
}

.input-placeholder,
.textarea-placeholder,
.input::placeholder,
.textarea::placeholder {
  color: var(--text-placeholder);
}

/* 常用辅助 */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.required {
  color: var(--primary);
}

/* 骨架屏公共样式 */
.skeleton-card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--border);
  overflow: hidden;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 12rpx;
  background: var(--border);
  position: relative;
  overflow: hidden;
}

.skeleton-line::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
  animation: skeleton-shimmer 1.6s infinite;
}

.skeleton-pill {
  height: 40rpx;
  width: 120rpx;
  border-radius: 999rpx;
  background: var(--border);
  position: relative;
  overflow: hidden;
}

.skeleton-pill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
  animation: skeleton-shimmer 1.6s infinite;
}

.skeleton-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--border);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.skeleton-circle::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
  animation: skeleton-shimmer 1.6s infinite;
}

.skeleton-btn {
  background: var(--border);
  height: 72rpx;
  border-radius: 16rpx;
}

.skeleton-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border);
}

@keyframes skeleton-shimmer {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(100%);
  }
}

/* 弹窗动效（全局复用） */
@keyframes modal-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes success-pop {
  0% {
    transform: scale(0.9);
    opacity: 0.6;
  }
  60% {
    transform: scale(1.04);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes check-pop {
  0% {
    transform: scale(0);
  }
  70% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
  }
}

.sk-w-30 { width: 30%; }
.sk-w-40 { width: 40%; }
.sk-w-50 { width: 50%; }
.sk-w-60 { width: 60%; }
.sk-w-70 { width: 70%; }
.sk-w-80 { width: 80%; }
.sk-w-90 { width: 90%; }
.sk-w-100 { width: 100%; }
