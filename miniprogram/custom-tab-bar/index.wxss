.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(9, 11, 18, 0.95);
  backdrop-filter: blur(20px);
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.32);
  border-top: 2rpx solid #1F2937;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #64748b;
  padding: 8rpx 0;
  position: relative;
}

.tab-item.active {
  color: #F43F7A;
}

.tab-item.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #F43F7A;
  box-shadow: 0 0 12rpx rgba(244, 63, 122, 0.25);
}

.tab-item.active .tab-icon {
  text-shadow: 0 0 16rpx rgba(244, 63, 122, 0.5);
}

.tab-icon {
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1;
}

.tab-text {
  font-size: 22rpx;
  font-weight: 500;
}
