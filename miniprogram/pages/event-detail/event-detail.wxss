.container {
  padding-bottom: 180rpx;
}

.event-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  margin: -32rpx -28rpx 32rpx;
  padding: 80rpx 40rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.event-hero::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.event-hero::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: 20%;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.hero-title {
  line-height: 1.4;
  font-size: 44rpx;
  position: relative;
  z-index: 1;
  color: white;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.hero-meta {
  font-size: 26rpx;
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.9);
}

.hero-badges {
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.requirement-text {
  line-height: 1.7;
}

.badge-progress {
  margin-left: auto;
  font-size: 24rpx;
}

.reward-card {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.08) 100%);
  border: 2rpx solid rgba(251, 191, 36, 0.2);
  position: relative;
  overflow: hidden;
}

.reward-text {
  line-height: 1.7;
}

.checked-status {
  text-align: center;
  padding: 48rpx 32rpx;
}

.check-icon {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.15), rgba(52, 211, 153, 0.08));
  color: var(--success);
  border-radius: 50%;
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 24rpx rgba(52, 211, 153, 0.15), 0 0 0 1rpx rgba(52, 211, 153, 0.2);
}

.check-icon.pending {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(251, 191, 36, 0.08));
  color: var(--warning);
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.15), 0 0 0 1rpx rgba(251, 191, 36, 0.2);
}

.check-status-title {
  font-size: 36rpx;
}

.check-status-desc {
  font-size: 28rpx;
}

.note-text {
  background: var(--bg);
  padding: 24rpx;
  border-radius: 16rpx;
  color: var(--text-secondary);
  text-align: left;
  line-height: 1.6;
  border: 2rpx solid var(--border);
}

.checkin-image {
  width: 100%;
  max-height: 400rpx;
  border-radius: 16rpx;
}

.checkin-video {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 16rpx;
  font-weight: 600;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  line-height: 1.6;
  color: var(--text);
}

.textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(244, 63, 122, 0.1);
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  color: var(--text);
}

.input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(244, 63, 122, 0.1);
}

.upload-area {
  width: 280rpx;
  height: 280rpx;
  background: var(--bg);
  border: 2rpx dashed rgba(244, 63, 122, 0.35);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.2s;
}

.upload-area-empty {
  background: rgba(244, 63, 122, 0.04);
}

.upload-area-empty:active {
  border-color: rgba(244, 63, 122, 0.7);
  background: rgba(244, 63, 122, 0.08);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-video {
  width: 100%;
  height: 100%;
  background: #000;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: rgba(255, 255, 255, 0.45);
}

.upload-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 44rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.upload-placeholder-text {
  font-size: 26rpx;
}

.makeup-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 28rpx;
  border-radius: 18rpx;
  background: var(--info-soft);
  border: 2rpx solid rgba(59, 130, 246, 0.2);
}

.makeup-banner-title {
  color: var(--info);
  font-size: 28rpx;
  font-weight: 700;
}

.edit-banner {
  position: relative;
  padding: 22rpx 24rpx;
  margin-bottom: 28rpx;
  border-radius: 18rpx;
  background: rgba(244, 63, 122, 0.08);
  border: 2rpx solid rgba(244, 63, 122, 0.2);
}

.edit-banner-title {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
}

.edit-banner-desc {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.edit-banner-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--primary);
  font-size: 26rpx;
  padding: 10rpx 16rpx;
}

.makeup-banner-desc {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.makeup-clear {
  margin: 0;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: var(--surface);
  color: var(--info);
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid rgba(59, 130, 246, 0.2);
}

.makeup-clear::after {
  border: none;
}

.reject-banner {
  padding: 22rpx 24rpx;
  margin-bottom: 28rpx;
  border-radius: 18rpx;
  background: var(--danger-soft);
  border: 2rpx solid rgba(239, 68, 68, 0.2);
}

.reject-title {
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 700;
}

.reject-desc {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}

.streak-info {
  justify-content: space-around;
  padding: 28rpx 24rpx;
  background: var(--bg);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid var(--border);
}

.streak-item {
  text-align: center;
  flex: 1;
}

.streak-num {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.streak-item:first-child .streak-num {
  background: linear-gradient(135deg, var(--warning), var(--warning-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.streak-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.calendar-weekday {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 16rpx 0 12rpx;
  font-weight: 500;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 14rpx;
  color: var(--text-secondary);
  font-weight: 500;
  transition: all 0.2s;
  position: relative;
  flex-direction: column;
  background: var(--bg);
}

.calendar-day.checked {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: white;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 122, 0.25);
}

.calendar-day.today {
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.calendar-day.today.checked {
  border: none;
  color: white;
}

.calendar-day.pending {
  background: var(--warning-soft);
  color: var(--warning);
}

.calendar-day.rejected,
.calendar-day.missed {
  background: var(--danger-soft);
  color: var(--danger);
}

.calendar-day.can-makeup {
  background: var(--info-soft);
  color: var(--info);
  border: 2rpx solid rgba(59, 130, 246, 0.3);
}

.day-tag {
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
}

.calendar-day.disabled {
  color: var(--border-light);
  background: transparent;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-top: 24rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.calendar-legend view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: inline-block;
}

.checked-dot {
  background: var(--primary);
}

.pending-dot {
  background: var(--warning);
}

.makeup-dot {
  background: var(--info);
}

.missed-dot {
  background: var(--danger);
}

.checkin-card {
  border: none;
  background: linear-gradient(180deg, rgba(244, 63, 122, 0.08) 0%, var(--surface) 40%);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
}

.checkin-title {
  font-size: 34rpx;
}

.login-prompt-card {
  border: none;
  background: linear-gradient(180deg, rgba(244, 63, 122, 0.08) 0%, var(--surface) 50%);
}

.login-prompt-inner {
  text-align: center;
  padding: 20rpx 0;
}

.login-prompt-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-prompt-desc {
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.join-prompt-card {
  text-align: center;
  padding: 60rpx 40rpx;
}

.join-prompt-desc {
  margin-bottom: 32rpx;
}

.calendar-total {
  font-size: 26rpx;
}

.calendar-tip {
  text-align: center;
  font-size: 24rpx;
  margin-top: 24rpx;
}

.reminder-card {
  border: 2rpx solid var(--border);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.2);
}

.reminder-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.reminder-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 700;
}

.reminder-desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.reminder-time-row {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid var(--border);
}

.reminder-time-row text:last-child {
  color: var(--primary);
}

.reminder-tip {
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.ranking-entry {
  transition: all 0.2s;
}

.ranking-entry:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.badge-item {
  width: calc(25% - 15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: var(--bg);
  border-radius: 16rpx;
  opacity: 0.5;
  filter: grayscale(100%);
  transition: all 0.3s;
  border: 2rpx solid var(--border);
}

.badge-item.achieved {
  opacity: 1;
  filter: none;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.08) 100%);
  box-shadow: 0 4rpx 12rpx rgba(251, 191, 36, 0.12);
  border: 2rpx solid rgba(251, 191, 36, 0.2);
}

.badge-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--warning-soft);
  color: var(--warning);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.badge-name {
  font-size: 22rpx;
  color: var(--text);
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.badge-target {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.badge-item.achieved .badge-target {
  color: var(--warning);
}

.material-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
  transition: all 0.2s;
  border: 2rpx solid var(--border);
}

.material-item:active {
  transform: scale(0.98);
  background: var(--surface);
  border-color: var(--border-light);
}

.material-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid var(--border);
}

.material-info {
  flex: 1;
  min-width: 0;
}

.material-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
}

.material-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
}

.feed-card {
  padding-bottom: 20rpx;
}

.feed-count {
  font-size: 24rpx;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.feed-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--border);
}

.feed-item:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.feed-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--border), var(--surface));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  border: 2rpx solid var(--border-light);
  overflow: hidden;
}

.feed-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.feed-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.feed-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feed-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.feed-name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-date {
  color: var(--text-muted);
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.feed-note {
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.feed-image {
  width: 320rpx;
  max-width: 80%;
  border-radius: 16rpx;
  background: var(--bg);
  display: block;
}

.feed-video {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.feed-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 4rpx;
}

.feed-tag {
  display: inline-flex;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--warning-soft);
  color: var(--warning);
  font-size: 18rpx;
  font-weight: 700;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
  flex-shrink: 0;
}

.feed-like {
  margin: 0;
  min-width: 96rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid var(--border);
}

.feed-like.liked {
  background: var(--primary-soft);
  color: var(--primary);
  border: 1rpx solid rgba(244, 63, 122, 0.2);
}

.feed-like::after {
  border: none;
}

.detail-sticky-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(9, 11, 18, 0.96);
  border-top: 2rpx solid var(--border);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(18px);
}

.sticky-primary,
.sticky-secondary,
.sticky-rank {
  margin: 0;
  height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sticky-primary,
.sticky-secondary {
  flex: 1;
}

.sticky-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text);
  box-shadow: 0 8rpx 20rpx rgba(244, 63, 122, 0.22);
}

.sticky-secondary {
  background: var(--success-soft);
  color: var(--success);
  border: 1rpx solid rgba(52, 211, 153, 0.2);
}

.sticky-rank {
  width: 168rpx;
  background: var(--surface);
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}

.sticky-primary::after,
.sticky-secondary::after,
.sticky-rank::after {
  border: none;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 640px;
  height: 1100px;
}

/* 状态横幅 */
.status-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.status-banner.upcoming {
  background: var(--accent-soft);
  border: 2rpx solid rgba(139, 92, 246, 0.2);
}

.status-banner.expired {
  background: rgba(100, 116, 139, 0.1);
  border: 2rpx solid rgba(100, 116, 139, 0.2);
}

.status-banner-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-banner.upcoming .status-banner-icon {
  color: var(--accent);
}

.status-banner.expired .status-banner-icon {
  color: var(--text-muted);
}

.status-banner-content {
  flex: 1;
}

.status-banner-title {
  font-size: 30rpx;
  font-weight: 700;
}

.status-banner.upcoming .status-banner-title {
  color: var(--accent-light);
}

.status-banner.expired .status-banner-title {
  color: var(--text-secondary);
}

.status-banner-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}

.status-banner.upcoming .status-banner-desc {
  color: var(--accent-lighter);
}

.status-banner.expired .status-banner-desc {
  color: var(--text-muted);
}

/* 补充孩子名弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-width: 560rpx;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  border: 2rpx solid var(--border);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  height: 88rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: var(--text);
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.modal-input::placeholder {
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn-secondary {
  background: var(--border-light);
  color: var(--text-secondary);
}

.modal-btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
}

.success-content {
  padding: 48rpx 36rpx 36rpx;
}

.success-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.success-btn {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.success-btn::after {
  border: none;
}

.success-btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.25);
}

.success-btn-share {
  background: var(--surface);
  color: var(--text);
  border: 2rpx solid var(--primary);
}

.success-close {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 分享活动入口卡片 */
.share-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.14) 0%, rgba(139, 92, 246, 0.14) 100%);
  border: 2rpx solid rgba(244, 63, 122, 0.25);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.share-card:active {
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.22) 0%, rgba(139, 92, 246, 0.22) 100%);
}

.share-card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.share-card-text {
  flex: 1;
  min-width: 0;
}

.share-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.share-card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.share-card-arrow {
  color: var(--text-muted);
  font-size: 28rpx;
}

/* 分享链接弹窗 */
.share-link-box {
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.share-link-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  word-break: break-all;
  line-height: 1.5;
}

.share-expire-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 28rpx;
}
