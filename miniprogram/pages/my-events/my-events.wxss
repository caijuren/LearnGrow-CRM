.container {
  padding-bottom: 60rpx;
}

.page-header {
  padding: 24rpx 4rpx 32rpx;
}

.back-row {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
  color: var(--text-secondary);
}

.back-arrow {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 600;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
}

.page-header .text-xl {
  font-size: 40rpx;
  color: var(--text);
}

.event-card {
  position: relative;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.24);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.event-card:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.event-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.event-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}

.status-pill {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-pill.active {
  background: var(--success-soft);
  color: var(--success);
}

.status-pill.done {
  background: rgba(100, 116, 139, 0.12);
  color: var(--text-muted);
}

.event-meta {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.event-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border);
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-total {
  font-size: 24rpx;
  color: var(--text-muted);
  -webkit-text-fill-color: var(--text-muted);
  font-weight: 500;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.event-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  font-size: 36rpx;
}
