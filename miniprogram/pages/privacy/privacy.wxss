.privacy-container {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.privacy-header {
  margin-bottom: 28rpx;
  padding: 8rpx 4rpx;
}

.privacy-header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.privacy-header-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  font-weight: 500;
}

.privacy-content {
  padding: 36rpx 32rpx;
}

.section {
  margin-bottom: 36rpx;
}

.section:last-of-type {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary);
  border-radius: 4rpx;
  line-height: 1.3;
}

.section-text {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 12rpx;
}

.section-text:last-child {
  margin-bottom: 0;
}

.bold {
  font-weight: 600;
  color: var(--text);
}

.footer {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--border);
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}
