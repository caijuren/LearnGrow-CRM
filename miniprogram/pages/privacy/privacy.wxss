.privacy-container {
  min-height: 100vh;
  background: #090B12;
  padding: 24rpx;
}

.privacy-content {
  background: #111522;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #1F2937;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #f8fafc;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.bold {
  font-weight: bold;
  color: #cbd5e1;
}

.footer {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #1F2937;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #64748b;
}
