<view class="container">
  <view class="header flex-between items-center mb-4">
    <view>
      <view class="greeting text-xl font-bold">你好，{{userInfo.nickname || '游客家长'}}</view>
      <view class="text-secondary mt-1">{{isLoggedIn ? '今天也要坚持打卡哦' : '登录后可参与打卡活动'}}</view>
    </view>
    <view class="avatar" bindtap="{{isLoggedIn ? 'goToProfile' : 'goToLogin'}}">
      <image wx:if="{{isLoggedIn && userInfo.avatar_url && !brokenAvatars.mine}}" class="avatar-img" src="{{baseUrl}}{{userInfo.avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="mine" />
      <text wx:else>{{isLoggedIn ? (userInfo.nickname ? userInfo.nickname[0] : '我') : '登'}}</text>
    </view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="login-banner mb-4" bindtap="goToLogin">
    <view class="login-banner-text">
      <text class="login-banner-title">立即登录</text>
      <text class="login-banner-desc">登录后即可报名活动并打卡</text>
    </view>
    <text class="login-banner-arrow">→</text>
  </view>

  <!-- 首次加载骨架屏 -->
  <block wx:if="{{loading && !loadedOnce}}">
    <block wx:if="{{isLoggedIn}}">
      <view class="skeleton-card skeleton-today">
        <view class="skeleton-main">
          <view class="skeleton-col">
            <view class="skeleton-line sk-w-40"></view>
            <view class="skeleton-line sk-w-70 mt-2"></view>
          </view>
          <view class="skeleton-circle"></view>
        </view>
        <view class="skeleton-line sk-w-100 mt-3"></view>
      </view>
    </block>
    <view class="skeleton-card">
      <view class="flex-between">
        <view class="skeleton-line sk-w-50"></view>
        <view class="skeleton-pill"></view>
      </view>
      <view class="skeleton-line sk-w-80 mt-3"></view>
      <view class="skeleton-line sk-w-60 mt-2"></view>
      <view class="skeleton-actions">
        <view class="skeleton-btn sk-w-60"></view>
        <view class="skeleton-btn sk-w-30"></view>
      </view>
    </view>
    <view class="skeleton-card">
      <view class="flex-between">
        <view class="skeleton-line sk-w-50"></view>
        <view class="skeleton-pill"></view>
      </view>
      <view class="skeleton-line sk-w-80 mt-3"></view>
      <view class="skeleton-line sk-w-60 mt-2"></view>
      <view class="skeleton-actions">
        <view class="skeleton-btn sk-w-60"></view>
        <view class="skeleton-btn sk-w-30"></view>
      </view>
    </view>
  </block>
  <block wx:else>
  <!-- 网络异常占位 -->
  <view wx:if="{{networkError}}" class="empty">
    <view class="empty-icon">!</view>
    <view class="empty-title">当前无法连接服务器</view>
    <view class="empty-desc">可能是网络不稳定或服务器域名配置未完成</view>
    <button class="btn-primary mt-4" bindtap="retryLoadEvents">重新加载</button>
  </view>

  <block wx:if="{{!networkError}}">
  <view wx:if="{{isLoggedIn}}" class="today-panel">
    <view class="today-main">
      <view class="today-text">
        <view class="today-label">今日任务</view>
        <view wx:if="{{todaySummary.joined > 0}}" class="today-title">
          {{todaySummary.pending > 0 ? '还有' + todaySummary.pending + '个待打卡' : '今日已全部完成'}}
        </view>
        <view wx:else class="today-title">还没有报名活动</view>
        <view wx:if="{{todaySummary.nextEvent}}" class="today-subtitle truncate">{{todaySummary.nextEvent.name}}</view>
        <view wx:else class="today-subtitle truncate">报名活动后，这里会显示今天的打卡任务</view>
      </view>
      <view class="today-ring {{todaySummary.pending === 0 && todaySummary.joined > 0 ? 'done' : ''}}" style="--progress: {{todayRingPercent}}%">
        <view class="ring-hole">
          <text class="ring-completed">{{todaySummary.completed}}</text><text class="ring-total">/{{todaySummary.joined}}</text>
        </view>
      </view>
    </view>
    <button wx:if="{{todaySummary.nextEvent && todaySummary.pending > 0}}" class="today-action" bindtap="goToTodayTask">
      去打卡
    </button>
    <button wx:elif="{{todaySummary.nextEvent}}" class="today-action done" bindtap="goToTodayTask">
      查看进度
    </button>
    <button wx:else class="today-action secondary" bindtap="goToMyCheckins">
      我的打卡
    </button>
  </view>

  <!-- 即将开始 -->
  <view wx:if="{{upcomingEvents.length > 0}}" class="section-header upcoming">
    <view class="section-title">即将开始</view>
    <view class="section-count">{{upcomingEvents.length}}个活动</view>
  </view>

  <view wx:for="{{upcomingEvents}}" wx:key="id" class="event-card upcoming" bindtap="goToDetail" data-id="{{item.id}}">
    <view class="event-header">
      <view class="event-title text-lg font-bold">{{item.name}}</view>
      <view class="status-pill upcoming">{{item.is_joined ? '已报名' : '即将开始'}}</view>
    </view>

    <view class="event-meta flex gap-3 mt-2">
      <view class="meta-item">
        <text class="meta-value">{{item.start_date}} ~ {{item.end_date}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-value">{{item.participant_count}}人参与</text>
      </view>
    </view>

    <view wx:if="{{item.required_text}}" class="required-text mt-3">
      <text class="text-muted meta-hint">打卡要求：{{item.required_text}}</text>
    </view>

    <view class="event-actions mt-3 flex gap-2">
      <button wx:if="{{isLoggedIn && !item.is_joined && item.can_signup}}" class="btn-primary btn-small" catchtap="handleJoin" data-id="{{item.id}}" data-name="{{item.name}}">
        立即报名
      </button>
      <button class="btn-secondary btn-small" catchtap="goToRanking" data-id="{{item.id}}">
        排行榜
      </button>
    </view>
  </view>

  <!-- 进行中 -->
  <view wx:if="{{ongoingEvents.length > 0}}" class="section-header">
    <view class="section-title">进行中</view>
    <view class="section-count">{{ongoingEvents.length}}个活动</view>
  </view>

  <view wx:for="{{ongoingEvents}}" wx:key="id" class="event-card" bindtap="goToDetail" data-id="{{item.id}}">
    <view class="event-header">
      <view class="event-title text-lg font-bold">{{item.name}}</view>
      <view wx:if="{{isLoggedIn && item.today_checked}}" class="status-pill done">已完成</view>
      <view wx:elif="{{isLoggedIn && item.is_joined}}" class="status-pill pending">待打卡</view>
      <view wx:else class="badge badge-muted">{{isLoggedIn ? '未报名' : '浏览中'}}</view>
    </view>

    <view class="event-meta flex gap-3 mt-2">
      <view class="meta-item">
        <text class="meta-value">{{item.start_date}} ~ {{item.end_date}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-value">{{item.participant_count}}人参与</text>
      </view>
    </view>

    <view wx:if="{{isLoggedIn && item.is_joined}}" class="progress-section">
      <view class="progress-header">
        <text>我的进度</text>
        <text>{{item.my_checkin_days}}/{{item.total_days}}天</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{item.progressPercent}}%"></view>
      </view>
      <view class="progress-footer">
        <text wx:if="{{item.my_current_streak >= 2}}" class="streak-text">连续{{item.my_current_streak}}天</text>
        <text wx:else class="text-muted">加油坚持哦～</text>
        <text wx:if="{{item.days_left >= 0}}" class="days-left">还剩{{item.days_left}}天</text>
      </view>
    </view>

    <view wx:if="{{item.required_text}}" class="required-text mt-3">
      <text class="text-muted meta-hint">打卡要求：{{item.required_text}}</text>
    </view>

    <view class="event-actions mt-3 flex gap-2">
      <button wx:if="{{isLoggedIn && !item.is_joined && item.can_signup}}" class="btn-primary btn-small" catchtap="handleJoin" data-id="{{item.id}}" data-name="{{item.name}}">
        立即报名
      </button>
      <view wx:elif="{{isLoggedIn && !item.is_joined}}" class="btn-disabled btn-small">报名已截止</view>
      <button wx:if="{{isLoggedIn && item.is_joined && !item.today_checked}}" class="btn-primary btn-small" catchtap="handleQuickCheckin" data-id="{{item.id}}">
        立即打卡
      </button>
      <button class="btn-secondary btn-small" catchtap="goToRanking" data-id="{{item.id}}">
        排行榜
      </button>
    </view>
  </view>

  <view wx:if="{{upcomingEvents.length === 0 && ongoingEvents.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">○</view>
    <view class="empty-title">暂无活动</view>
    <view class="empty-desc">暂时没有进行中的活动，稍后再来看看吧～</view>
  </view>
  </block>
  </block>

  <!-- 登录提示弹窗 -->
  <view wx:if="{{showLoginPrompt}}" class="modal-mask" bindtap="closeLoginPrompt">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-title">需要登录</view>
      <view class="modal-desc">登录后可查看个人打卡记录和更多信息，游客模式下仍可继续浏览活动。</view>
      <view class="modal-actions">
        <button class="modal-btn modal-btn-secondary" bindtap="closeLoginPrompt">先逛逛</button>
        <button class="modal-btn modal-btn-primary" bindtap="confirmLoginPrompt">去登录</button>
      </view>
    </view>
  </view>
</view>
