.container {
  padding-bottom: 180rpx;
}

.header {
  padding: 24rpx 4rpx 32rpx;
}

.greeting {
  color: #f8fafc;
  font-size: 40rpx;
  letter-spacing: 0.5rpx;
  text-shadow: 0 0 24rpx rgba(244, 63, 122, 0.25);
}

.login-banner {
  background: #111522;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #1F2937;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.24);
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.login-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #F43F7A, transparent);
}

.login-banner-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.login-banner-text text:first-child {
  color: #F43F7A;
  font-size: 28rpx;
  font-weight: 600;
}

.login-banner-text text:last-child {
  color: #64748b;
  font-size: 24rpx;
}

.login-banner-arrow {
  font-size: 40rpx;
  color: #F43F7A;
  font-weight: 300;
}

.today-panel {
  background: #111522;
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.28);
  border: 2rpx solid #1F2937;
  position: relative;
  overflow: hidden;
}

.today-panel::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.today-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.today-text {
  flex: 1;
  min-width: 0;
}

.today-label {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.today-title {
  color: #f8fafc;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-subtitle {
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-ring {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: #090B12;
  border: 7rpx solid #F43F7A;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #F43F7A;
  flex-shrink: 0;
  box-shadow: 0 0 24rpx rgba(244, 63, 122, 0.25);
  box-sizing: border-box;
}

.today-ring.done {
  background: #090B12;
  border-color: #34d399;
  color: #34d399;
  box-shadow: 0 0 24rpx rgba(52, 211, 153, 0.25);
}

.ring-completed {
  display: inline;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}

.ring-total {
  display: inline;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.today-action {
  margin: 26rpx 0 0;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #F43F7A 0%, #ec4899 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(244, 63, 122, 0.25);
}

.today-action.done {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.2);
}

.today-action.secondary {
  background: #111522;
  color: #94a3b8;
  box-shadow: none;
  border: 2rpx solid #1F2937;
}

.today-action::after {
  border: none;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-header.upcoming {
  margin-top: 16rpx;
}

.section-header.expired {
  margin-top: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f8fafc;
}

.section-header.upcoming .section-title {
  color: #8B5CF6;
}

.section-header.expired .section-title {
  color: #64748b;
}

.section-count {
  font-size: 24rpx;
  color: #64748b;
}

.event-card {
  background: #111522;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.24);
  position: relative;
  overflow: hidden;
  border: 2rpx solid #1F2937;
}

.event-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #F43F7A;
  box-shadow: 0 0 16rpx rgba(244, 63, 122, 0.4);
}

.event-card.upcoming::before {
  background: #8B5CF6;
  box-shadow: 0 0 16rpx rgba(139, 92, 246, 0.4);
}

.event-card.expired::before {
  background: #374151;
  box-shadow: none;
}

.event-card.expired {
  opacity: 0.7;
}

.event-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.event-title {
  flex: 1;
  line-height: 1.5;
  font-size: 32rpx;
  color: #f8fafc;
}

.event-meta {
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 20rpx 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.meta-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.progress-section {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #090B12;
  border-radius: 16rpx;
  border: 2rpx solid #1F2937;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-header text:first-child {
  font-size: 26rpx;
  color: #94a3b8;
}

.progress-header text:last-child {
  font-size: 28rpx;
  color: #F43F7A;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #1F2937;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F43F7A, #ec4899);
  border-radius: 10rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 12rpx rgba(244, 63, 122, 0.3);
}

.progress-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.streak-text {
  color: #fbbf24;
  font-weight: 500;
}

.progress-footer .text-muted {
  color: #64748b;
}

.required-text {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #090B12;
  border-radius: 16rpx;
  line-height: 1.6;
  font-size: 26rpx;
  color: #94a3b8;
  border-left: 4rpx solid #F43F7A;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.status-pill.done {
  background: rgba(52, 211, 153, 0.12);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.2);
}

.status-pill.pending {
  background: rgba(251, 191, 36, 0.12);
  color: #fbbf24;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.status-pill.upcoming {
  background: rgba(139, 92, 246, 0.12);
  color: #8B5CF6;
  border: 1rpx solid rgba(139, 92, 246, 0.2);
}

.status-pill.expired {
  background: rgba(100, 116, 139, 0.12);
  color: #64748b;
  border: 1rpx solid rgba(100, 116, 139, 0.2);
}

.event-actions {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #1F2937;
  display: flex;
  gap: 16rpx;
}

.event-actions .btn-small {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}
