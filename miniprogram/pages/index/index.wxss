.container {
  padding-bottom: 180rpx;
}

.header {
  padding: 24rpx 4rpx 32rpx;
}

.greeting {
  color: var(--text);
  font-size: 40rpx;
  letter-spacing: 0.5rpx;
  text-shadow: 0 0 24rpx var(--primary-glow);
}

.login-banner {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--border);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.24);
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.login-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--primary), transparent);
}

.login-banner-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.login-banner-title {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

.login-banner-desc {
  color: var(--text-muted);
  font-size: 24rpx;
}

.login-banner-arrow {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 500;
}

.today-panel {
  background: var(--surface);
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.28);
  border: 2rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.today-panel::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.today-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.today-text {
  flex: 1;
  min-width: 0;
}

.today-label {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.today-title {
  color: var(--text);
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-subtitle {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 10rpx;
}

.today-ring {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: conic-gradient(var(--primary) var(--progress), var(--border) 0);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  flex-shrink: 0;
  box-shadow: 0 0 24rpx var(--primary-glow);
  box-sizing: border-box;
}

.today-ring.done {
  background: conic-gradient(var(--success) var(--progress), var(--border) 0);
  color: var(--success);
  box-shadow: 0 0 24rpx rgba(52, 211, 153, 0.25);
}

.ring-hole {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-completed {
  display: inline;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}

.ring-total {
  display: inline;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.today-action {
  margin: 26rpx 0 0;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(244, 63, 122, 0.25);
}

.today-action.done {
  background: linear-gradient(135deg, var(--success) 0%, var(--success-dark) 100%);
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.2);
}

.today-action.secondary {
  background: var(--surface);
  color: var(--text-secondary);
  box-shadow: none;
  border: 2rpx solid var(--border);
}

.today-action::after {
  border: none;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-header.upcoming,
.section-header.expired {
  margin-top: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.section-header.upcoming .section-title {
  color: var(--accent);
}

.section-header.expired .section-title {
  color: var(--text-muted);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.event-card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.24);
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--border);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.event-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.event-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--primary);
  box-shadow: 0 0 16rpx rgba(244, 63, 122, 0.4);
}

.event-card.upcoming::before {
  background: var(--accent);
  box-shadow: 0 0 16rpx rgba(139, 92, 246, 0.4);
}

.event-card.expired::before {
  background: var(--border-light);
  box-shadow: none;
}

.event-card.expired {
  opacity: 0.7;
}

.event-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.event-title {
  flex: 1;
  line-height: 1.5;
  font-size: 32rpx;
  color: var(--text);
}

.event-meta {
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 20rpx 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.meta-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.meta-hint {
  font-size: 24rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.progress-section {
  margin-top: 28rpx;
  padding: 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-header text:first-child {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-header text:last-child {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: var(--border);
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 10rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 12rpx rgba(244, 63, 122, 0.3);
}

.progress-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.streak-text {
  color: var(--warning);
  font-weight: 500;
}

.days-left {
  color: var(--text-muted);
}

.required-text {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
  line-height: 1.6;
  border-left: 4rpx solid var(--primary);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.status-pill.done {
  background: var(--success-soft);
  color: var(--success);
  border: 1rpx solid rgba(52, 211, 153, 0.2);
}

.status-pill.pending {
  background: var(--warning-soft);
  color: var(--warning);
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.status-pill.upcoming {
  background: var(--accent-soft);
  color: var(--accent);
  border: 1rpx solid rgba(139, 92, 246, 0.2);
}

.status-pill.expired {
  background: rgba(100, 116, 139, 0.12);
  color: var(--text-muted);
  border: 1rpx solid rgba(100, 116, 139, 0.2);
}

.event-actions {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border);
  display: flex;
  gap: 16rpx;
}

.event-actions .btn-small {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.event-actions .btn-primary.btn-small {
  flex: 1;
}

.event-actions .btn-secondary.btn-small {
  flex: none;
  width: 200rpx;
}

/* 骨架屏（页面级布局） */
.skeleton-today {
  padding: 28rpx;
}

.skeleton-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.skeleton-col {
  flex: 1;
  min-width: 0;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  background: #111522;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  width: 100%;
  max-width: 560rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 1;
  padding: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.modal-btn::after {
  border: none;
}

.modal-btn-secondary {
  background: #1F2937;
  color: #cbd5e1;
}

.modal-btn-primary {
  background: linear-gradient(135deg, #F43F7A 0%, #ec4899 100%);
  color: white;
}
