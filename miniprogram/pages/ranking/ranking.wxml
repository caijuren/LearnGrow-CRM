<view class="container">
  <view class="ranking-header">
    <view class="ranking-header-title">打卡排行榜</view>
    <view class="ranking-header-subtitle">坚持打卡，见证成长每一步</view>
  </view>

  <view wx:if="{{myRank}}" class="my-rank-card">
    <view class="my-rank-main">
      <image wx:if="{{myRank.avatar_url && !brokenAvatars.mine}}" class="my-rank-avatar" src="{{baseUrl}}{{myRank.avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="mine" />
      <view wx:else class="my-rank-avatar">{{myRank.nickname[0]}}</view>
      <view class="my-rank-body">
        <view class="my-rank-label">我的排名</view>
        <view class="my-rank-title">第 {{myRank.rank}} 名</view>
        <view class="my-rank-subtitle">
          已打卡 {{myRank.checkin_days}} 天
          <text wx:if="{{myRank.current_streak >= 2}}"> · 连续 {{myRank.current_streak}} 天</text>
        </view>
      </view>
    </view>
    <view class="my-rank-gap">
      <text wx:if="{{myRank.rank === 1}}">领先中</text>
      <text wx:elif="{{myRank.gap_to_previous === 0}}">并列</text>
      <text wx:else>差 {{myRank.gap_to_previous}} 天</text>
    </view>
  </view>

  <view wx:if="{{ranking.length >= 3}}" class="podium">
    <view class="podium-item second">
      <view class="podium-rank rank-2">2</view>
      <image wx:if="{{ranking[1].avatar_url && !brokenAvatars.p2}}" class="podium-avatar" src="{{baseUrl}}{{ranking[1].avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="p2" />
      <view wx:else class="podium-avatar">{{ranking[1].nickname[0]}}</view>
      <view class="podium-name">{{ranking[1].nickname}}</view>
      <view class="podium-days">{{ranking[1].checkin_days}} 天</view>
    </view>
    <view class="podium-item first">
      <view class="podium-crown">
        <text class="crown-icon">◆</text>
      </view>
      <view class="podium-rank rank-1">1</view>
      <image wx:if="{{ranking[0].avatar_url && !brokenAvatars.p1}}" class="podium-avatar gold" src="{{baseUrl}}{{ranking[0].avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="p1" />
      <view wx:else class="podium-avatar gold">{{ranking[0].nickname[0]}}</view>
      <view class="podium-name">{{ranking[0].nickname}}</view>
      <view class="podium-days">{{ranking[0].checkin_days}} 天</view>
    </view>
    <view class="podium-item third">
      <view class="podium-rank rank-3">3</view>
      <image wx:if="{{ranking[2].avatar_url && !brokenAvatars.p3}}" class="podium-avatar bronze" src="{{baseUrl}}{{ranking[2].avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="p3" />
      <view wx:else class="podium-avatar bronze">{{ranking[2].nickname[0]}}</view>
      <view class="podium-name">{{ranking[2].nickname}}</view>
      <view class="podium-days">{{ranking[2].checkin_days}} 天</view>
    </view>
  </view>

  <view class="list-section-title">全部排名</view>
  <view class="ranking-list card">
    <view wx:if="{{loading}}" class="ranking-skeleton">
      <view class="ranking-item">
        <view class="skeleton-circle"></view>
        <view class="flex-1">
          <view class="skeleton-line sk-w-40"></view>
          <view class="skeleton-line sk-w-60 mt-2"></view>
        </view>
      </view>
      <view class="ranking-item">
        <view class="skeleton-circle"></view>
        <view class="flex-1">
          <view class="skeleton-line sk-w-40"></view>
          <view class="skeleton-line sk-w-60 mt-2"></view>
        </view>
      </view>
      <view class="ranking-item">
        <view class="skeleton-circle"></view>
        <view class="flex-1">
          <view class="skeleton-line sk-w-40"></view>
          <view class="skeleton-line sk-w-60 mt-2"></view>
        </view>
      </view>
    </view>
    <view wx:if="{{ranking.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">○</view>
      <view class="empty-title">暂无排名数据</view>
      <view class="empty-desc">快去参与活动，登上榜单吧</view>
    </view>
    <view wx:for="{{ranking}}" wx:key="rank" class="ranking-item {{item.is_me ? 'is-me' : ''}}">
      <view class="rank-num {{item.rank <= 3 ? 'rank-top-' + item.rank : ''}}">{{item.rank}}</view>
      <image wx:if="{{item.avatar_url && !brokenAvatars['i' + index]}}" class="user-avatar" src="{{baseUrl}}{{item.avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="{{'i' + index}}" />
      <view wx:else class="user-avatar">{{item.nickname[0]}}</view>
      <view class="user-info">
        <view class="user-name">
          <text class="user-name-text">{{item.nickname}}</text>
          <text wx:if="{{item.is_me}}" class="badge badge-rose">我</text>
        </view>
        <view wx:if="{{item.current_streak >= 2}}" class="streak-tag">连续 {{item.current_streak}} 天</view>
      </view>
      <view class="user-days">{{item.checkin_days}} 天</view>
    </view>
  </view>
</view>
