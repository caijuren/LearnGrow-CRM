.container {
  padding-bottom: 60rpx;
}

.ranking-header {
  background: linear-gradient(135deg, #F43F7A 0%, #8B5CF6 100%);
  margin: -32rpx -28rpx 0;
  padding: 80rpx 40rpx 140rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.ranking-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.ranking-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: 10%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.ranking-header .text-xl {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  color: white;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 20rpx;
  margin: -80rpx 0 32rpx;
  padding: 0 4rpx;
  position: relative;
  z-index: 10;
}

.my-rank-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #111522;
  border-radius: 22rpx;
  padding: 28rpx 32rpx;
  margin: -92rpx 0 28rpx;
  position: relative;
  z-index: 12;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28);
  border: 2rpx solid #1F2937;
}

.my-rank-label {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.my-rank-title {
  color: #f8fafc;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  margin-top: 6rpx;
}

.my-rank-subtitle {
  color: #64748b;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.my-rank-gap {
  min-width: 128rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.12);
  color: #fbbf24;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.podium-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #111522;
  border-radius: 28rpx;
  padding: 28rpx 12rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.28);
  position: relative;
  border: 2rpx solid #1F2937;
}

.podium-item.first {
  transform: translateY(-20rpx) scale(1.05);
  z-index: 2;
  background: linear-gradient(180deg, rgba(251, 191, 36, 0.12) 0%, #111522 60%);
  box-shadow: 0 16rpx 48rpx rgba(251, 191, 36, 0.15);
  border-color: rgba(251, 191, 36, 0.25);
}

.podium-item.second {
  background: linear-gradient(180deg, rgba(148, 163, 184, 0.1) 0%, #111522 60%);
}

.podium-item.third {
  background: linear-gradient(180deg, rgba(249, 115, 22, 0.1) 0%, #111522 60%);
}

.podium-crown {
  font-size: 56rpx;
  margin-bottom: 4rpx;
  animation: bounce 2s ease-in-out infinite;
  filter: drop-shadow(0 0 8rpx rgba(251, 191, 36, 0.4));
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.podium-rank {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  color: #f8fafc;
}

.podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F43F7A, #8B5CF6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(244, 63, 122, 0.25);
}

.podium-avatar.gold {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.3);
}

.podium-avatar.bronze {
  background: linear-gradient(135deg, #fb923c, #ea580c);
  box-shadow: 0 6rpx 20rpx rgba(249, 115, 22, 0.25);
}

.podium-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #f8fafc;
  margin-bottom: 6rpx;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-days {
  font-size: 26rpx;
  color: #F43F7A;
  font-weight: 700;
}

.podium-item.first .podium-days {
  font-size: 28rpx;
  color: #fbbf24;
}

.ranking-list {
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: #111522;
  border: 2rpx solid #1F2937;
}

.ranking-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #1F2937;
  transition: background 0.2s;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item.is-me {
  background: linear-gradient(90deg, rgba(244, 63, 122, 0.08) 0%, #111522 100%);
}

.rank-num {
  width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #64748b;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F43F7A, #8B5CF6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 122, 0.15);
}

.user-info {
  min-width: 0;
  flex: 1;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f8fafc;
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.streak-tag {
  font-size: 22rpx;
  color: #fbbf24;
  font-weight: 500;
}

.user-days {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #F43F7A, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.list-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f8fafc;
  margin: 0 4rpx 20rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #F43F7A;
  border-radius: 4rpx;
}
