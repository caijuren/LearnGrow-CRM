.container {
  padding-bottom: 180rpx;
}

.event-switcher {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  max-width: 100%;
}

.event-switcher-name {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 460rpx;
}

.event-switcher-arrow {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

.ranking-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  margin: 0 0 0;
  padding: 48rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(244, 63, 122, 0.28);
}

.ranking-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.ranking-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: 10%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.ranking-header-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.ranking-header-subtitle {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
  font-weight: 500;
}

.my-rank-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 0 28rpx;
  position: relative;
  z-index: 12;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28);
  border: 2rpx solid var(--border);
  animation: rank-fade-up 0.4s ease-out both;
}

.my-rank-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
  flex: 1;
}

.my-rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx var(--primary-glow);
}

image.my-rank-avatar {
  display: block;
}

.my-rank-body {
  min-width: 0;
  flex: 1;
}

.my-rank-title {
  color: var(--text);
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
}

.my-rank-subtitle {
  color: var(--text-muted);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.my-rank-gap {
  padding: 0 20rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--warning-soft);
  color: var(--warning);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
  flex-shrink: 0;
}

.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 20rpx;
  margin: 0 0 32rpx;
  padding-top: 24rpx;
  position: relative;
  z-index: 10;
  animation: rank-fade-up 0.4s ease-out 0.08s both;
}

.podium-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-item {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx 12rpx 26rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.28);
  position: relative;
  border: 2rpx solid var(--border);
  box-sizing: border-box;
}

/* 阶梯：通过 podium-col 的 padding-top 制造高度差（第一名最高） */
.podium-col.first {
  padding-top: 0;
}

.podium-col.second {
  padding-top: 48rpx;
}

.podium-col.third {
  padding-top: 88rpx;
}

.podium-col.first .podium-item {
  padding-top: 48rpx;
  z-index: 2;
  background: linear-gradient(180deg, rgba(251, 191, 36, 0.14) 0%, var(--surface) 60%);
  box-shadow: 0 16rpx 48rpx rgba(251, 191, 36, 0.18);
  border-color: rgba(251, 191, 36, 0.3);
}

.podium-col.second .podium-item {
  background: linear-gradient(180deg, rgba(203, 213, 225, 0.12) 0%, var(--surface) 60%);
  border-color: rgba(203, 213, 225, 0.22);
}

.podium-col.third .podium-item {
  background: linear-gradient(180deg, rgba(217, 119, 6, 0.12) 0%, var(--surface) 60%);
  border-color: rgba(217, 119, 6, 0.2);
}

/* 台阶底座 */
.podium-step {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.podium-step.step-1 {
  background: linear-gradient(180deg, #fcd34d, #f59e0b);
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.35);
}

.podium-step.step-2 {
  background: linear-gradient(180deg, #cbd5e1, #94a3b8);
  box-shadow: 0 4rpx 16rpx rgba(148, 163, 184, 0.3);
}

.podium-step.step-3 {
  background: linear-gradient(180deg, #fdba74, #d97706);
  box-shadow: 0 4rpx 16rpx rgba(217, 119, 6, 0.3);
}

.podium-crown {
  margin-bottom: 4rpx;
  will-change: transform;
  animation: bounce 2s ease-in-out infinite;
}

.crown-icon {
  font-size: 40rpx;
  color: #fcd34d;
  text-shadow: 0 0 12rpx rgba(251, 191, 36, 0.6);
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes rank-fade-up {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.podium-rank {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
  color: var(--text);
}

.podium-rank.rank-1 {
  background: linear-gradient(135deg, #fcd34d, #f59e0b);
  color: #7c2d12;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.4);
}

.podium-rank.rank-2 {
  background: linear-gradient(135deg, #e2e8f0, #94a3b8);
  color: #334155;
  box-shadow: 0 4rpx 12rpx rgba(148, 163, 184, 0.35);
}

.podium-rank.rank-3 {
  background: linear-gradient(135deg, #fdba74, #d97706);
  color: #7c2d12;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.35);
}

.podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  border: 3rpx solid rgba(203, 213, 225, 0.7);
  box-sizing: border-box;
}

/* 金银铜细边框 */
.podium-avatar.gold {
  background: linear-gradient(135deg, #fcd34d, #f59e0b);
  border: 3rpx solid #fcd34d;
  width: 104rpx;
  height: 104rpx;
  font-size: 40rpx;
}

.podium-avatar.bronze {
  background: linear-gradient(135deg, #fdba74, #d97706);
  border: 3rpx solid #d97706;
}

image.podium-avatar {
  display: block;
}

.podium-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-days {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 700;
}

.podium-col.first .podium-days {
  font-size: 28rpx;
  color: var(--warning);
}

/* 领奖台上的「我」标识 */
.podium-me {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: var(--primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 122, 0.4);
}

.list-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin: 0 4rpx 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary);
  border-radius: 4rpx;
}

.ranking-list {
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.ranking-skeleton .ranking-item:last-child {
  border-bottom: none;
}

.ranking-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
  transition: background 0.2s;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item.is-me {
  background: linear-gradient(90deg, var(--primary-soft) 0%, var(--surface) 100%);
}

.rank-num {
  width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-muted);
  flex-shrink: 0;
}

.rank-num.rank-top-1 {
  color: var(--warning);
  text-shadow: 0 0 12rpx rgba(251, 191, 36, 0.35);
}

.rank-num.rank-top-2 {
  color: #e2e8f0;
}

.rank-num.rank-top-3 {
  color: #fdba74;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx var(--primary-glow);
}

image.user-avatar {
  display: block;
}

.user-info {
  min-width: 0;
  flex: 1;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 6rpx;
}

.user-name-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  margin-left: 10rpx;
}

.badge-rose {
  background: var(--primary-soft);
  color: var(--primary);
}

.streak-tag {
  font-size: 22rpx;
  color: var(--warning);
  font-weight: 500;
}

.user-days {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
}
