.container {
  padding-bottom: 80rpx;
}

.points-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 32rpx;
  padding: 56rpx 36rpx 48rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.points-hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.points-hero::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: 20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.points-hero-label {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.points-hero-num {
  position: relative;
  z-index: 1;
  font-size: 96rpx;
  font-weight: 700;
  color: white;
  line-height: 1.25;
}

.points-hero-desc {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.ledger-card {
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.section-title-inline {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.ledger-count {
  font-size: 24rpx;
}

.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.ledger-item:last-child {
  border-bottom: none;
}

.ledger-main {
  flex: 1;
  min-width: 0;
}

.ledger-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.ledger-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.ledger-note {
  font-size: 24rpx;
  color: var(--text-muted);
}

.ledger-time {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.ledger-amount {
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ledger-amount.plus {
  color: var(--success);
}

.ledger-amount.minus {
  color: var(--danger);
}

.skeleton-last {
  border-bottom: none;
}
