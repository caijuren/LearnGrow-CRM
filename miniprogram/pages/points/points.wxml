<view class="container">
  <view class="points-hero">
    <view class="points-hero-label">当前积分</view>
    <view class="points-hero-num">{{balance}}</view>
    <view class="points-hero-desc">打卡和购买产品可获得积分</view>
  </view>

  <view class="card ledger-card">
    <view class="flex-between items-center mb-3">
      <view class="section-title-inline">积分明细</view>
      <text class="text-muted ledger-count">共 {{items.length}} 条</text>
    </view>

    <block wx:if="{{loading && !loadedOnce}}">
      <view class="ledger-item">
        <view class="skeleton-line sk-w-40"></view>
        <view class="skeleton-line sk-w-30"></view>
      </view>
      <view class="ledger-item">
        <view class="skeleton-line sk-w-40"></view>
        <view class="skeleton-line sk-w-30"></view>
      </view>
      <view class="ledger-item skeleton-last">
        <view class="skeleton-line sk-w-40"></view>
        <view class="skeleton-line sk-w-30"></view>
      </view>
    </block>

    <view wx:if="{{items.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">分</view>
      <view class="empty-title">暂无积分记录</view>
      <view class="empty-desc">完成打卡或购买产品即可获得积分</view>
    </view>

    <view wx:for="{{items}}" wx:key="id" class="ledger-item">
      <view class="ledger-main">
        <view class="ledger-title">
          <text class="ledger-type">{{item.type === 'checkin' ? '打卡' : item.type === 'order' ? '订单' : '手动调整'}}</text>
          <text wx:if="{{item.note}}" class="ledger-note">{{item.note}}</text>
        </view>
        <view class="ledger-time">{{item.created_at}}</view>
      </view>
      <view class="ledger-amount {{item.amount > 0 ? 'plus' : 'minus'}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</view>
    </view>
  </view>
</view>
