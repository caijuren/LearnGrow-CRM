.container {
  padding-bottom: 60rpx;
}

.page-header {
  padding: 24rpx 4rpx 32rpx;
}

.back-row {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
  color: var(--text-secondary);
}

.back-arrow {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 600;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
}

.page-header .text-xl {
  font-size: 40rpx;
  color: var(--text);
}

.checkin-card {
  position: relative;
  overflow: hidden;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: linear-gradient(180deg, rgba(244, 63, 122, 0.08) 0%, var(--surface) 40%);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.checkin-card:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.checkin-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  box-shadow: 0 0 16rpx rgba(244, 63, 122, 0.35);
}

.event-date {
  font-size: 26rpx;
}

.stats-row {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-box {
  flex: 1;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 2rpx solid var(--border);
}

.stat-box:nth-child(2) {
  border-color: rgba(251, 191, 36, 0.2);
}

.stat-box:nth-child(3) {
  border-color: rgba(52, 211, 153, 0.2);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-warning {
  background: linear-gradient(135deg, var(--warning), var(--warning-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-success {
  background: linear-gradient(135deg, var(--success), var(--success-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  font-weight: 500;
}

.mini-calendar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mini-day {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--border);
  transition: all 0.2s;
}

.mini-day.checked {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  box-shadow: 0 2rpx 8rpx rgba(244, 63, 122, 0.25);
}

.records-scroll {
  white-space: nowrap;
  margin: 0 -4rpx;
  padding: 4rpx;
}

.records-list {
  padding: 4rpx 0;
  display: inline-flex;
  gap: 16rpx;
}

.record-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.record-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.record-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.12), rgba(52, 211, 153, 0.06));
  color: var(--success);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  border: 2rpx solid rgba(52, 211, 153, 0.15);
}

.record-video {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(139, 92, 246, 0.08));
  color: var(--accent-light);
  border: 2rpx solid rgba(139, 92, 246, 0.25);
}

.record-date {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.recent-records {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--border);
}

.recent-records-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 20rpx;
}
