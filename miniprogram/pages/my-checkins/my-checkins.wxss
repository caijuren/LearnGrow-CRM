.container {
  padding-bottom: 180rpx;
}

.page-header {
  padding: 24rpx 4rpx 32rpx;
}

.page-header .text-xl {
  font-size: 40rpx;
  color: #f8fafc;
}

.checkin-card {
  position: relative;
  overflow: hidden;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: linear-gradient(180deg, rgba(244, 63, 122, 0.08) 0%, #111522 40%);
}

.checkin-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #F43F7A, #8B5CF6);
  box-shadow: 0 0 16rpx rgba(244, 63, 122, 0.35);
}

.stats-row {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-box {
  flex: 1;
  background: #090B12;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 2rpx solid #1F2937;
}

.stat-box:nth-child(2) {
  background: #090B12;
  border-color: rgba(251, 191, 36, 0.2);
}

.stat-box:nth-child(3) {
  background: #090B12;
  border-color: rgba(52, 211, 153, 0.2);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #F43F7A, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-box:nth-child(2) .stat-num {
  background: linear-gradient(135deg, #fbbf24, #f97316);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-box:nth-child(3) .stat-num {
  background: linear-gradient(135deg, #34d399, #10b981);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  font-weight: 500;
}

.mini-calendar {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.mini-day {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: #1F2937;
  transition: all 0.2s;
}

.mini-day.checked {
  background: linear-gradient(135deg, #F43F7A, #ec4899);
  box-shadow: 0 2rpx 8rpx rgba(244, 63, 122, 0.25);
}

.records-scroll {
  white-space: nowrap;
  margin: 0 -4rpx;
  padding: 4rpx;
}

.records-list {
  padding: 4rpx 0;
  display: inline-flex;
  gap: 16rpx;
}

.record-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.record-image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.record-placeholder {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.12), rgba(52, 211, 153, 0.06));
  color: #34d399;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  border: 2rpx solid rgba(52, 211, 153, 0.15);
}

.record-video {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(139, 92, 246, 0.08));
  color: #a78bfa;
  border: 2rpx solid rgba(139, 92, 246, 0.25);
}

.record-date {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.recent-records {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #1F2937;
}

.recent-records .text-secondary {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 20rpx;
}
