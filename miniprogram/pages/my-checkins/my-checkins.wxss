.container {
  padding-bottom: 60rpx;
}

.page-header {
  padding: 24rpx 4rpx 32rpx;
}

.back-row {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
  color: var(--text-secondary);
}

.back-arrow {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 600;
}

.back-text {
  font-size: 28rpx;
  font-weight: 500;
}

.page-header .text-xl {
  font-size: 40rpx;
  color: var(--text);
}

/* 统计概览 */
.stats-overview {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-box {
  flex: 1;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
}

.stat-box:nth-child(2) {
  border-color: rgba(251, 191, 36, 0.2);
}

.stat-box:nth-child(3) {
  border-color: rgba(52, 211, 153, 0.2);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-num-primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-warning {
  background: linear-gradient(135deg, var(--warning), var(--warning-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-success {
  background: linear-gradient(135deg, var(--success), var(--success-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  font-weight: 500;
}

/* 打卡时间流 */
.timeline-item {
  position: relative;
  padding: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.timeline-item:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.timeline-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.timeline-event-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  line-height: 1.4;
}

.timeline-date {
  font-size: 24rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  font-weight: 500;
}

.makeup-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--accent-soft);
  color: var(--accent-light);
  border: 1rpx solid rgba(139, 92, 246, 0.25);
  margin-bottom: 12rpx;
}

.timeline-note {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 12rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.timeline-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.timeline-video {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
