<view class="container">
  <view class="page-header">
    <view class="back-row" bindtap="goBack">
      <text class="back-arrow">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="text-xl font-bold">我的打卡</view>
    <view class="text-secondary mt-1">每一次坚持都算数</view>
  </view>

  <!-- 首次加载骨架屏 -->
  <block wx:if="{{isLoggedIn && loading && !loadedOnce}}">
    <view class="skeleton-card">
      <view class="flex-between">
        <view class="skeleton-line sk-w-40"></view>
        <view class="skeleton-line sk-w-30"></view>
      </view>
      <view class="skeleton-line sk-w-80 mt-3"></view>
      <view class="skeleton-line sk-w-60 mt-2"></view>
    </view>
    <view class="skeleton-card">
      <view class="flex-between">
        <view class="skeleton-line sk-w-40"></view>
        <view class="skeleton-line sk-w-30"></view>
      </view>
      <view class="skeleton-line sk-w-80 mt-3"></view>
      <view class="skeleton-line sk-w-60 mt-2"></view>
    </view>
  </block>

  <view wx:if="{{!isLoggedIn}}" class="empty">
    <view class="empty-icon">锁</view>
    <view class="empty-title">登录后查看打卡记录</view>
    <view class="empty-desc">登录后即可查看您的所有打卡活动</view>
    <view class="mt-4">
      <button class="btn-primary btn-small" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <block wx:if="{{isLoggedIn && !loading}}">
    <!-- 统计概览 -->
    <view class="stats-overview">
      <view class="stat-box">
        <view class="stat-num stat-num-primary font-bold">{{stats.totalDays}}</view>
        <view class="stat-label">累计打卡</view>
      </view>
      <view class="stat-box">
        <view class="stat-num stat-num-warning font-bold">{{stats.maxStreak}}</view>
        <view class="stat-label">最长连续</view>
      </view>
      <view class="stat-box">
        <view class="stat-num stat-num-success font-bold">{{stats.totalEvents}}</view>
        <view class="stat-label">参与活动</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{feed.length === 0}}" class="empty">
      <view class="empty-icon">空</view>
      <view class="empty-title">还没有打卡记录</view>
      <view class="empty-desc">参加活动并完成打卡后，记录会显示在这里</view>
    </view>

    <!-- 打卡时间流 -->
    <view wx:for="{{feed}}" wx:key="id" class="timeline-item card" bindtap="goToEvent" data-id="{{item.event_id}}">
      <view class="timeline-head">
        <view class="timeline-event-name">{{item.event_name}}</view>
        <view class="timeline-date">{{item.dateText}}</view>
      </view>
      <view wx:if="{{item.is_makeup}}" class="makeup-tag">补卡</view>
      <view wx:if="{{item.note}}" class="timeline-note">{{item.note}}</view>
      <block wx:if="{{item.image_url}}">
        <image wx:if="{{item.media_type !== 'video'}}" class="timeline-image" src="{{baseUrl}}{{item.image_url}}" mode="aspectFill" />
        <video wx:else class="timeline-video" src="{{baseUrl}}{{item.image_url}}" object-fit="cover" controls="{{true}}" />
      </block>
    </view>
  </block>
</view>
