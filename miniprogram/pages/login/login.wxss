.login-container {
  min-height: 100vh;
  background: #090B12;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.login-container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  left: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.18) 0%, transparent 60%);
  pointer-events: none;
}

.login-container::after {
  content: '';
  position: absolute;
  bottom: -200rpx;
  right: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.14) 0%, transparent 60%);
  pointer-events: none;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
  position: relative;
  z-index: 1;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 0 24rpx rgba(244, 63, 122, 0.35));
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-card {
  background: #111522;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.32);
  border: 2rpx solid #1F2937;
  position: relative;
  z-index: 1;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #f8fafc;
  text-align: center;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: #07c160;
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.btn-wechat::after {
  border: none;
}

.wx-icon {
  font-size: 32rpx;
}

.btn-skip {
  width: 100%;
  height: 92rpx;
  background: #090B12;
  color: #94a3b8;
  border-radius: 46rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1F2937;
  margin-bottom: 32rpx;
}

.btn-skip::after {
  border: none;
}

.btn-skip:active {
  border-color: #F43F7A;
  color: #F43F7A;
  background: rgba(244, 63, 122, 0.08);
}

.agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 0 24rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #374151;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: white;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #F43F7A;
  border-color: #F43F7A;
}

.agreement-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
  flex: 1;
  text-align: left;
}

.link {
  color: #F43F7A;
  font-weight: 500;
}

.footer-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 昵称设置弹窗 */
.nickname-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.nickname-modal {
  background: #111522;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 40rpx;
  margin: 0 48rpx;
  width: calc(100% - 96rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  border: 2rpx solid #1F2937;
}

.nickname-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #f8fafc;
  text-align: center;
  margin-bottom: 12rpx;
}

.nickname-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: #0B0F1A;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #f8fafc;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  border: 2rpx solid #1F2937;
}

.avatar-picker {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 auto 40rpx;
  background: #0B0F1A;
  border: 1.5rpx dashed rgba(244, 63, 122, 0.35);
  overflow: hidden;
  position: relative;
  transition: all 0.2s;
}

.avatar-picker::after {
  border: none;
}

.avatar-picker:active {
  border-color: rgba(244, 63, 122, 0.7);
  background: rgba(244, 63, 122, 0.08);
}

.avatar-picker-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.avatar-placeholder-icon {
  font-size: 40rpx;
  color: rgba(244, 63, 122, 0.85);
  margin-bottom: 8rpx;
  line-height: 1;
  font-weight: 300;
}

.avatar-placeholder-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
}

.nickname-input:focus {
  border-color: #F43F7A;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.35);
}

.nickname-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #F43F7A 0%, #ec4899 100%);
  color: white;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.25);
}

.btn-save::after {
  border: none;
}

.btn-skip-nickname {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: #64748b;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-skip-nickname::after {
  border: none;
}
