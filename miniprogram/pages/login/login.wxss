.login-container {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 0 40rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.login-container::before {
  content: '';
  position: absolute;
  top: -180rpx;
  right: -140rpx;
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.22) 0%, transparent 62%);
  pointer-events: none;
}

.login-container::after {
  content: '';
  position: absolute;
  bottom: -140rpx;
  left: -160rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.18) 0%, transparent 62%);
  pointer-events: none;
}

.login-header {
  text-align: center;
  color: var(--text);
  position: relative;
  z-index: 1;
  padding-top: 120rpx;
}

.logo {
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto 36rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text);
  box-shadow: 0 16rpx 48rpx var(--primary-glow);
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.login-tags {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 48rpx;
}

.login-tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.login-bottom {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 0 48rpx 64rpx;
}

.agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text);
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
}

.link {
  color: var(--primary);
  font-weight: 500;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: #07c160;
  color: var(--text);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
  transition: all 0.2s;
  white-space: nowrap;
  flex-wrap: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat.btn-disabled {
  background: rgba(7, 193, 96, 0.35);
  box-shadow: none;
}

.btn-wechat:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.wx-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.wx-icon::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
}

.wx-icon::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: -22rpx -18rpx 0 -2rpx #fff;
}

.btn-text {
  flex-shrink: 0;
}

.btn-skip {
  width: 100%;
  height: 92rpx;
  padding: 0 32rpx;
  background: var(--bg);
  color: var(--text-secondary);
  border-radius: 46rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
}

.btn-skip::after {
  border: none;
}

.btn-skip:active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(244, 63, 122, 0.08);
}

/* 昵称设置弹窗 */
.nickname-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: modal-fade-in 0.2s ease-out;
}

.nickname-modal {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  margin: 0 48rpx;
  width: calc(100% - 96rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  animation: success-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.nickname-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
  margin-bottom: 12rpx;
}

.nickname-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 44rpx;
}

.profile-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 44rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  padding: 0;
  margin: 0;
  background: var(--surface-elevated);
  border: 2rpx dashed rgba(244, 63, 122, 0.35);
  position: relative;
  transition: all 0.2s;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  max-height: 120rpx;
  min-width: 120rpx;
  max-width: 120rpx;
}

.avatar-preview::after {
  border: none;
}

.avatar-preview:active {
  border-color: rgba(244, 63, 122, 0.7);
  background: rgba(244, 63, 122, 0.08);
}

.avatar-wx-btn {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  margin: 0;
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid rgba(244, 63, 122, 0.35);
  transition: all 0.2s;
  box-sizing: border-box;
  white-space: nowrap;
}

.avatar-wx-btn::after {
  border: none;
}

.avatar-wx-btn:active {
  background: rgba(244, 63, 122, 0.2);
  border-color: rgba(244, 63, 122, 0.6);
  transform: scale(0.96);
}

.avatar-picker-img {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.avatar-placeholder-icon {
  font-size: 44rpx;
  color: rgba(244, 63, 122, 0.75);
  line-height: 1;
}

.avatar-required {
  border-color: rgba(244, 63, 122, 0.7) !important;
  background: rgba(244, 63, 122, 0.08) !important;
}

.avatar-edit-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--primary);
  border-radius: 50%;
  border: 4rpx solid var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  font-size: 20rpx;
  color: var(--text);
  line-height: 1;
}

.form-group {
  width: 100%;
}

.form-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: var(--surface-elevated);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text);
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  transition: border-color 0.2s;
}

.nickname-input:focus {
  border-color: var(--primary);
}

.input-placeholder {
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.nickname-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text);
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.25);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-save::after {
  border: none;
}

.btn-save:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-skip-nickname {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: var(--text-muted);
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-skip-nickname::after {
  border: none;
}

.btn-skip-nickname:active {
  transform: scale(0.98);
  opacity: 0.7;
}

.network-fallback-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: rgba(244, 63, 122, 0.12);
  border: 2rpx solid rgba(244, 63, 122, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}
