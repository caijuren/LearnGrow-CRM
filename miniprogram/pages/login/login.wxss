.login-container {
  min-height: 100vh;
  background: var(--bg);
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.login-container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  left: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.18) 0%, transparent 60%);
  pointer-events: none;
}

.login-container::after {
  content: '';
  position: absolute;
  bottom: -200rpx;
  right: -100rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.14) 0%, transparent 60%);
  pointer-events: none;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
  color: var(--text);
  position: relative;
  z-index: 1;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text);
  box-shadow: 0 8rpx 32rpx var(--primary-glow);
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.32);
  border: 2rpx solid var(--border);
  position: relative;
  z-index: 1;
}

.agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text);
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
  text-align: left;
}

.link {
  color: var(--primary);
  font-weight: 500;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: #07c160;
  color: var(--text);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
  transition: all 0.2s;
  white-space: nowrap;
  flex-wrap: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat.btn-disabled {
  background: rgba(7, 193, 96, 0.35);
  box-shadow: none;
}

.wx-icon {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

.btn-text {
  flex-shrink: 0;
}

.btn-skip {
  width: 100%;
  height: 92rpx;
  padding: 0 32rpx;
  background: var(--bg);
  color: var(--text-secondary);
  border-radius: 46rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
}

.btn-skip::after {
  border: none;
}

.btn-skip:active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(244, 63, 122, 0.08);
}

/* 昵称设置弹窗 */
.nickname-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.nickname-modal {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  margin: 0 48rpx;
  width: calc(100% - 96rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
}

.nickname-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
  margin-bottom: 12rpx;
}

.nickname-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 44rpx;
}

.profile-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 44rpx;
}

.avatar-picker {
  width: 152rpx;
  height: 152rpx;
  border-radius: 28rpx;
  padding: 0;
  margin: 0;
  background: var(--surface-elevated);
  border: 2rpx dashed rgba(244, 63, 122, 0.35);
  overflow: hidden;
  position: relative;
  transition: all 0.2s;
}

.avatar-picker::after {
  border: none;
}

.avatar-picker:active {
  border-color: rgba(244, 63, 122, 0.7);
  background: rgba(244, 63, 122, 0.08);
}

.avatar-picker-img {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.avatar-placeholder-icon {
  font-size: 44rpx;
  color: rgba(244, 63, 122, 0.75);
  margin-bottom: 10rpx;
  line-height: 1;
}

.avatar-placeholder-text {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  border-top-left-radius: 22rpx;
  border-bottom-right-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  font-size: 20rpx;
  color: var(--text);
  line-height: 1;
}

.form-group {
  width: 100%;
}

.form-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: var(--surface-elevated);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text);
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  transition: border-color 0.2s;
}

.nickname-input:focus {
  border-color: var(--primary);
}

.input-placeholder {
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.nickname-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text);
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.25);
}

.btn-save::after {
  border: none;
}

.btn-skip-nickname {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: var(--text-muted);
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-skip-nickname::after {
  border: none;
}
