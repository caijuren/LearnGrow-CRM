<view class="container">
  <view wx:if="{{!isLoggedIn}}" class="profile-guest">
    <view class="guest-avatar-wrap">
      <view class="guest-avatar">我</view>
    </view>
    <view class="guest-title">欢迎使用打卡小程序</view>
    <view class="guest-desc">登录后参与打卡活动，记录成长点滴</view>
    <button class="guest-login-btn" bindtap="goToLogin">
      <text>立即登录</text>
      <text class="btn-arrow">→</text>
    </button>
  </view>

  <block wx:if="{{isLoggedIn}}">
    <view class="profile-header">
      <view wx:if="{{!editing}}" class="profile-avatar avatar avatar-lg">
        <image wx:if="{{userInfo.avatar_url && !brokenAvatars.mine}}" class="profile-avatar-img" src="{{baseUrl}}{{userInfo.avatar_url}}" mode="aspectFill" binderror="onAvatarError" data-key="mine" />
        <text wx:else>{{userInfo.nickname ? userInfo.nickname[0] : '我'}}</text>
      </view>
      <view wx:if="{{!editing}}" class="profile-info">
        <view class="profile-name text-xl font-bold text-white">{{userInfo.nickname || '微信用户'}}</view>
        <view wx:if="{{userInfo.child_name}}" class="profile-child">
          孩子：{{userInfo.child_name}}
        </view>
        <view class="edit-btn" bindtap="startEdit">编辑资料</view>
      </view>
      <view wx:else class="profile-edit-form">
        <button
          class="profile-avatar-edit"
          open-type="chooseAvatar"
          bind:chooseavatar="onChooseAvatar"
        >
          <view class="avatar-inner">
            <image wx:if="{{editAvatarUrl && !brokenAvatars.edit}}" class="profile-avatar-img" src="{{editAvatarUrl}}" mode="aspectFill" binderror="onAvatarError" data-key="edit" />
            <text wx:else>{{editNickname ? editNickname[0] : '我'}}</text>
          </view>
          <view class="avatar-edit-badge">
            <text class="avatar-edit-icon">✎</text>
          </view>
        </button>
        <view class="edit-form-item">
          <input class="edit-input" placeholder="昵称" value="{{editNickname}}" bindinput="onNicknameInput" />
        </view>
        <view class="edit-form-item">
          <input class="edit-input" placeholder="孩子昵称" value="{{editChildName}}" bindinput="onChildNameInput" />
        </view>
        <view class="edit-actions">
          <button class="edit-btn-save" bindtap="saveProfile" loading="{{saving}}">保存</button>
          <button class="edit-btn-cancel" bindtap="cancelEdit">取消</button>
        </view>
      </view>
    </view>

    <view class="points-card" bindtap="goToPoints">
      <view class="points-info">
        <view class="points-num font-bold">{{pointsBalance}}</view>
        <view class="points-label text-muted">我的积分</view>
      </view>
      <view class="points-arrow">
        <text class="text-muted">查看明细</text>
        <text class="menu-arrow text-muted">→</text>
      </view>
    </view>

    <view class="stats-card card">
      <view class="stats-row flex gap-2">
        <view class="stat-item flex-1">
          <view class="stat-num stat-num-primary font-bold text-xl">{{joinedEvents}}</view>
          <view class="stat-label text-muted">参与活动</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item flex-1">
          <view class="stat-num stat-num-warning font-bold text-xl">{{totalDays}}</view>
          <view class="stat-label text-muted">累计打卡</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item flex-1">
          <view class="stat-num stat-num-success font-bold text-xl">{{totalStreak}}</view>
          <view class="stat-label text-muted">最长连续</view>
        </view>
      </view>
    </view>

    <view wx:if="{{myBadges.length > 0}}" class="card">
      <view class="flex-between items-center mb-3">
        <view class="section-title-inline">我的徽章</view>
        <text class="text-muted section-count">共 {{myBadges.length}} 个</text>
      </view>
      <view class="user-badge-row">
        <view wx:for="{{myBadges}}" wx:key="id" class="user-badge-item">
          <view class="user-badge-icon">{{item.badge_icon || '章'}}</view>
          <view class="user-badge-name">{{item.badge_name}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{myCheckins.length > 0}}" class="card">
      <view class="section-title-inline mb-3">我的活动</view>
      <view wx:for="{{myCheckins}}" wx:key="event.id" class="event-item" bindtap="goToEvent" data-id="{{item.event.id}}">
        <view class="flex-between items-center">
          <view class="flex-1">
            <view class="event-name font-semibold">{{item.event.name}}</view>
            <view class="text-muted mt-1 event-status">
              {{item.checkin_days}}天打卡 · {{item.event.status === 'active' ? '进行中' : '已结束'}}
            </view>
          </view>
          <text class="text-muted menu-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="card menu-card">
      <view class="menu-item" bindtap="goToMyCheckins">
        <view class="menu-icon">☰</view>
        <view class="menu-text">我的打卡记录</view>
        <text class="menu-arrow text-muted">→</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goHome">
        <view class="menu-icon">⌂</view>
        <view class="menu-text">返回活动列表</view>
        <text class="menu-arrow text-muted">→</text>
      </view>
    </view>

    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </block>

  <view class="bottom-nav">
    <view class="nav-item" bindtap="goHome">
      <text class="nav-icon">⌂</text>
      <text class="nav-text">活动</text>
    </view>
    <view class="nav-item" bindtap="goToMyCheckins">
      <text class="nav-icon">☰</text>
      <text class="nav-text">我的打卡</text>
    </view>
    <view class="nav-item active">
      <text class="nav-icon">◉</text>
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>
