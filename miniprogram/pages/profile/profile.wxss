.container {
  padding-bottom: 180rpx;
}

.profile-guest {
  background: linear-gradient(135deg, #F43F7A 0%, #8B5CF6 100%);
  border-radius: 32rpx;
  padding: 80rpx 48rpx 72rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.profile-guest::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.profile-guest::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: 20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.guest-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 0 40rpx rgba(244, 63, 122, 0.25);
}

.guest-avatar {
  font-size: 80rpx;
  position: relative;
  z-index: 1;
}

.guest-title {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
}

.guest-desc {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.guest-login-btn {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 92rpx;
  padding: 0 64rpx;
  background: #111522;
  color: #F43F7A;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.guest-login-btn::after {
  border: none;
}

.btn-arrow {
  font-size: 28rpx;
  font-weight: 500;
}

.profile-header {
  background: linear-gradient(135deg, #F43F7A 0%, #8B5CF6 100%);
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: white;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-avatar-edit {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: white;
  padding: 0;
  margin: 0 auto 24rpx;
}

.profile-avatar-edit::after {
  border: none;
}

.profile-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.profile-name {
  color: white;
  font-size: 38rpx;
}

.profile-child {
  color: rgba(255, 255, 255, 0.9);
}

.edit-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: white;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.profile-edit-form {
  flex: 1;
  position: relative;
  z-index: 1;
}

.edit-form-item {
  margin-bottom: 20rpx;
}

.edit-input {
  width: 100%;
  height: 76rpx;
  background: rgba(9, 11, 18, 0.85);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #f8fafc;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.edit-btn-save {
  background: #111522 !important;
  color: #F43F7A !important;
  font-size: 26rpx !important;
  padding: 14rpx 36rpx !important;
  border-radius: 24rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2) !important;
  margin: 0;
  line-height: 1.4;
  font-weight: 600;
  border: none !important;
}

.edit-btn-save::after {
  border: none;
}

.edit-btn-cancel {
  background: rgba(255, 255, 255, 0.15) !important;
  color: white !important;
  font-size: 26rpx !important;
  padding: 14rpx 36rpx !important;
  border-radius: 24rpx !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15) !important;
  margin: 0;
  line-height: 1.4;
}

.edit-btn-cancel::after {
  border: none;
}

.stats-card {
  text-align: center;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: #111522;
  border: 2rpx solid #1F2937;
}

.stats-card .stats-row {
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-item .text-xl {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-item:nth-child(1) .text-xl {
  background: linear-gradient(135deg, #F43F7A, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-item:nth-child(3) .text-xl {
  background: linear-gradient(135deg, #fbbf24, #f97316);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-item:nth-child(5) .text-xl {
  background: linear-gradient(135deg, #34d399, #10b981);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #1F2937;
  border-radius: 2rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.event-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #1F2937;
  transition: opacity 0.2s;
}

.event-item:last-child {
  border-bottom: none;
}

.event-item:active {
  opacity: 0.7;
}

.event-name {
  font-size: 30rpx;
  color: #f8fafc;
}

.menu-card {
  padding: 0;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: #111522;
  border: 2rpx solid #1F2937;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  transition: background 0.2s;
}

.menu-item:active {
  background: rgba(244, 63, 122, 0.08);
}

.menu-icon {
  font-size: 44rpx;
  width: 56rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #f8fafc;
  font-weight: 500;
}

.menu-arrow {
  color: #64748b;
  font-size: 32rpx;
  font-weight: 300;
}

.menu-divider {
  height: 2rpx;
  background: #1F2937;
  margin: 0 32rpx 0 112rpx;
}

.logout-btn {
  width: 100%;
  margin-top: 28rpx;
  background: #111522;
  color: #F43F7A;
  border-radius: 24rpx;
  font-size: 30rpx;
  padding: 28rpx;
  border: 2rpx solid #1F2937;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.logout-btn:active {
  transform: scale(0.98);
  background: rgba(244, 63, 122, 0.08);
  border-color: rgba(244, 63, 122, 0.3);
}

.logout-btn::after {
  border: none;
}

.section-title-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
}

.section-title-bar text {
  margin-right: 12rpx;
}

.user-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(20% - 13rpx);
  padding: 16rpx 8rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.06) 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(251, 191, 36, 0.15);
}

.user-badge-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.user-badge-name {
  font-size: 20rpx;
  color: #fbbf24;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}
