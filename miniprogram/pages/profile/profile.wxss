.container {
  padding-bottom: 180rpx;
}

.profile-guest {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 32rpx;
  padding: 80rpx 48rpx 72rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.profile-guest::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.profile-guest::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: 20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.guest-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 0 40rpx var(--primary-glow);
}

.guest-avatar {
  font-size: 56rpx;
  font-weight: 600;
  color: white;
  position: relative;
  z-index: 1;
}

.guest-title {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
}

.guest-desc {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.guest-login-btn {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 92rpx;
  padding: 0 64rpx;
  background: var(--surface);
  color: var(--primary);
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.guest-login-btn::after {
  border: none;
}

.btn-arrow {
  font-size: 28rpx;
  font-weight: 500;
}

.profile-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: white;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-avatar-edit {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: white;
  padding: 0;
  margin: 0 auto 24rpx;
  box-sizing: border-box;
  line-height: 1;
}

.profile-avatar-edit .avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-edit::after {
  border: none;
}

.profile-avatar-edit .avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  border-top-left-radius: 22rpx;
  border-bottom-right-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.profile-avatar-edit .avatar-edit-icon {
  font-size: 20rpx;
  color: var(--text);
  line-height: 1;
}

.profile-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.profile-name {
  color: white;
  font-size: 38rpx;
}

.profile-child {
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.edit-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: white;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.profile-edit-form {
  flex: 1;
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
}

.edit-form-item {
  margin-bottom: 20rpx;
}

.edit-input {
  width: 100%;
  max-width: 100%;
  height: 76rpx;
  background: rgba(9, 11, 18, 0.85);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.edit-actions {
  display: flex;
  gap: 20rpx;
}

.edit-btn-save,
.edit-btn-cancel {
  flex: 1;
  min-width: 0;
  font-size: 26rpx !important;
  padding: 14rpx 24rpx !important;
  border-radius: 24rpx !important;
  margin: 0;
  line-height: 1.4;
  font-weight: 600;
}

.edit-btn-save {
  background: var(--surface) !important;
  color: var(--primary) !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2) !important;
  border: none !important;
}

.edit-btn-save::after {
  border: none;
}

.edit-btn-cancel {
  background: rgba(255, 255, 255, 0.15) !important;
  color: white !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15) !important;
}

.edit-btn-cancel::after {
  border: none;
}

.stats-card {
  text-align: center;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.stats-card .stats-row {
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-item .text-xl {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-num-primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-warning {
  background: linear-gradient(135deg, var(--warning), var(--warning-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-num-success {
  background: linear-gradient(135deg, var(--success), var(--success-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border);
  border-radius: 2rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.event-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border);
  transition: opacity 0.2s;
}

.event-item:last-child {
  border-bottom: none;
}

.event-item:active {
  opacity: 0.7;
}

.event-name {
  font-size: 30rpx;
  color: var(--text);
}

.event-status {
  font-size: 24rpx;
}

.menu-card {
  padding: 0;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: var(--surface);
  border: 2rpx solid var(--border);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  transition: background 0.2s;
}

.menu-item:active {
  background: rgba(244, 63, 122, 0.08);
}

.menu-icon {
  font-size: 36rpx;
  width: 56rpx;
  text-align: center;
  color: var(--text-secondary);
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.menu-arrow {
  color: var(--text-muted);
  font-size: 32rpx;
  font-weight: 300;
}

.menu-divider {
  height: 2rpx;
  background: var(--border);
  margin: 0 32rpx 0 112rpx;
}

.logout-btn {
  width: 100%;
  margin-top: 28rpx;
  background: var(--surface);
  color: var(--primary);
  border-radius: 24rpx;
  font-size: 30rpx;
  padding: 28rpx;
  border: 2rpx solid var(--border);
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.logout-btn:active {
  transform: scale(0.98);
  background: rgba(244, 63, 122, 0.08);
  border-color: rgba(244, 63, 122, 0.3);
}

.logout-btn::after {
  border: none;
}

.section-title-inline {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.section-count {
  font-size: 24rpx;
}

.user-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(20% - 13rpx);
  padding: 16rpx 8rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.06) 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(251, 191, 36, 0.15);
}

.user-badge-icon {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--warning);
  margin-bottom: 8rpx;
}

.user-badge-name {
  font-size: 20rpx;
  color: var(--warning);
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.points-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.14) 0%, rgba(245, 158, 11, 0.05) 100%);
  border: 2rpx solid rgba(251, 191, 36, 0.2);
  transition: opacity 0.2s;
}

.points-card:active {
  opacity: 0.7;
}

.points-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.points-num {
  font-size: 56rpx;
  line-height: 1;
  background: linear-gradient(135deg, var(--warning), var(--warning-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.points-label {
  font-size: 26rpx;
}

.points-arrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

